# CircuitSense AI - Environment Configuration Example
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-key
CIRCUITSENSE_MODEL_PATH=models/best.pt
CIRCUITSENSE_FORCE_DEMO=false
CIRCUITSENSE_DEFAULT_CONFIDENCE=0.25
CIRCUITSENSE_DEFAULT_IOU=0.45
CIRCUITSENSE_CURRENCY=INR
MAX_UPLOAD_SIZE_MB=16
